# Copy to `.env` and fill in. Only ANTHROPIC_API_KEY is required.

# --- Required ---
# Get one at https://console.anthropic.com/settings/keys
#
# NOTE: this is the TEMPLATE and is committed to git. Never put a real key
# here — put it in `.env`, which is gitignored.
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# --- Optional: Adzuna (good India / Pune coverage) ---
# Free tier ~250 calls/day. Register: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Optional: JSearch via RapidAPI (aggregates LinkedIn/Indeed/Glassdoor) ---
# Free tier ~200 req/month. Subscribe: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
